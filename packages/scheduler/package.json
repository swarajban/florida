{
  "name": "@florida/scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic auto-scheduler: places tasks into free time around calendar events. Pure TypeScript, no I/O, no dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
