#!/usr/bin/env bash
# Prepares an Amp orb for this repository: pnpm workspace deps, scheduler build,
# and a Linux Swift toolchain so FloridaKit (apple/FloridaKit) can be built and
# tested here. SwiftUI/AppKit/UIKit targets still need a Mac.
set -euo pipefail

SWIFT_VERSION="6.4.2"
SWIFTLY_HOME="$HOME/.local/share/swiftly"

step() { printf '\n==> %s (%s)\n' "$1" "$(date +%T)"; }

step "System packages for the Swift toolchain"
missing=()
for pkg in libedit-dev libpython3-dev zip libsqlite3-dev libcurl4-openssl-dev libxml2-dev; do
  dpkg -s "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
if [ "${#missing[@]}" -gt 0 ]; then
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
else
  echo "already installed"
fi

step "Swift $SWIFT_VERSION via swiftly"
if [ ! -x "$SWIFTLY_HOME/toolchains/$SWIFT_VERSION/usr/bin/swift" ]; then
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/swiftly.tar.gz" "https://download.swift.org/swiftly/linux/swiftly-$(uname -m).tar.gz"
  tar -xzf "$tmp/swiftly.tar.gz" -C "$tmp"
  "$tmp/swiftly" init --assume-yes --skip-install --no-modify-profile
  # shellcheck disable=SC1091
  . "$SWIFTLY_HOME/env.sh"
  swiftly install --use --assume-yes "$SWIFT_VERSION"
  rm -rf "$tmp"
else
  echo "already installed"
fi

marker="# florida: swift toolchain"
for profile in "$HOME/.bash_profile" "$HOME/.profile"; do
  if ! grep -Fqx "$marker" "$profile" 2>/dev/null; then
    printf '\n%s\n. %q\n' "$marker" "$SWIFTLY_HOME/env.sh" >> "$profile"
  fi
done

step "pnpm workspace dependencies"
pnpm install --frozen-lockfile

step "Build @florida/scheduler (server imports its dist)"
pnpm --filter @florida/scheduler build

step "Resolve FloridaKit Swift dependencies"
if [ -f apple/FloridaKit/Package.swift ]; then
  # shellcheck disable=SC1091
  . "$SWIFTLY_HOME/env.sh"
  (cd apple/FloridaKit && swift package resolve)
fi

step "Done"
