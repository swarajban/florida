# Neon pooled connection string (the "-pooler" host). The server uses prepare: false for PgBouncer.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# Bearer token the apps send; also the `key` for /auth/google/start. `openssl rand -hex 32`
API_TOKEN=

# AES-256-GCM key for stored Google refresh tokens: 64 hex chars. `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=

# OAuth client (Web application) with redirect URI ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of this server, no trailing slash. Used for OAuth redirects and webhook addresses.
PUBLIC_URL=https://florida.fly.dev

PORT=8080
HORIZON_DAYS=28

# Optional. Enables POST /api/ai/parse-task (natural language → task draft via Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
