{
  "name": "@florida/server",
  "version": "0.1.0",
  "private": true,
  "description": "Florida API server: Hono + Drizzle (Postgres), Google Calendar sync, auto-scheduling jobs.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@florida/scheduler": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
